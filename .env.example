# --- Frontend (Vite) ---
# URL base del API Express (sin barra final). Ejemplo desarrollo:
VITE_API_BASE_URL=http://localhost:3001

# --- Backend (server/) — cargar con dotenv en Node, NO exponer en Vite ---
PORT=3001

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

CONTACT_TO_EMAIL=info@dinamicsystems.com
CONTACT_FROM_EMAIL=your-email@gmail.com

# Origen extra permitido por CORS (opcional)
# FRONTEND_ORIGIN=https://staging.dinamicsystems.com
