# --- Frontend (Vite) — solo necesario al construir el sitio estático en Hostinger ---
# URL base del API Express (sin barra final). El frontend (dinamicsystems.com) y el API
# (api-landing.dinamiceducation.com) viven en dominios distintos.
VITE_API_BASE_URL=https://api-landing.dinamiceducation.com

# --- Backend (server/) — cargar con dotenv en Node o env_file de Docker ---
NODE_ENV=production
PORT=3001

# Orígenes permitidos por CORS (lista separada por comas, sin espacios obligatorios).
# Debe incluir el dominio del frontend, NO el del API. No agregues dinamiceducation.com
# salvo que también consumas esta API desde una página alojada en ese dominio.
# En desarrollo local (NODE_ENV != production) se agregan automáticamente localhost:5173 y localhost:3000.
CORS_ALLOWED_ORIGINS=https://dinamicsystems.com,https://www.dinamicsystems.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

CONTACT_TO_EMAIL=info@dinamicsystems.com
CONTACT_FROM_EMAIL=your-email@gmail.com

# Origen extra permitido por CORS (opcional, legado — preferir CORS_ALLOWED_ORIGINS)
# FRONTEND_ORIGIN=https://staging.dinamicsystems.com
