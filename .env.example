# --- Backend (servidor Ubuntu / Docker) ---
# Copiá este archivo a .env en /opt/dinamic-systems-landing-api.
# No incluyas VITE_* aquí: esas variables son solo para el build del frontend React.

NODE_ENV=production
PORT=3001

# Orígenes del frontend (dinamicsystems.com). NO el dominio del API (dinamiceducation.com).
# En desarrollo local (NODE_ENV != production) se agregan automáticamente localhost:5173 y localhost:3000.
CORS_ALLOWED_ORIGINS=https://dinamicsystems.com,https://www.dinamicsystems.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

CONTACT_TO_EMAIL=info@dinamicsystems.com
CONTACT_FROM_EMAIL=your-email@gmail.com

# Origen extra permitido por CORS (opcional, legado — preferir CORS_ALLOWED_ORIGINS)
# FRONTEND_ORIGIN=https://staging.dinamicsystems.com
