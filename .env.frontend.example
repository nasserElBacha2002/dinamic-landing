# --- Frontend (Vite / build estático para Hostinger) ---
# Copiá a .env en la raíz del repo ANTES de `npm run build`.
# Vite embebe VITE_* en el bundle (build-time). No sirve en el .env del servidor API.

# URL del formulario (POST …/api/contact) — obligatoria salvo deploy Hostinger explícito:
# 1) Preferí siempre VITE_API_BASE_URL.
# 2) Solo si VITE_DEPLOY_ENV=production y falta la URL → fallback productivo.
# 3) `import.meta.env.PROD` NO habilita el fallback (evita apuntar a prod en builds locales).

# Producción (Hostinger):
VITE_API_BASE_URL=https://api-landing.dinamiceducation.com
# VITE_DEPLOY_ENV=production

# Desarrollo local:
# VITE_API_BASE_URL=http://localhost:3001

# Analítica (opcional; omitir = sin scripts)
# Solo Plausible está permitido hasta existir consent manager.
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_PLAUSIBLE_DOMAIN=dinamicsystems.com
# GA4 / gtag está bloqueado en código hasta consentimiento formal.
