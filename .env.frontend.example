# --- Frontend (Vite / build estático para Hostinger) ---
# Copiá a .env en la raíz del repo ANTES de `npm run build`.
# Vite embebe esta URL en el bundle; no sirve ponerla en el .env del servidor backend.

# Producción:
VITE_API_BASE_URL=https://api-landing.dinamiceducation.com

# Desarrollo local (descomentar y usar en tu .env local):
# VITE_API_BASE_URL=http://localhost:3001
