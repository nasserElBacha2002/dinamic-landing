# Static MPA on Hostinger/LiteSpeed.
# Do not rewrite unknown paths to /index.html.

DirectoryIndex index.html
Options -MultiViews -Indexes
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/xml xml
</IfModule>

# Crawlers must be able to read sitemap and robots.
# Hostinger/LiteSpeed has returned 403 for some bot user-agents on sitemap.xml.
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule ^(sitemap\.xml|robots\.txt)$ - [L]
</IfModule>

# Fase 1: 301 internos a URLs comerciales live (CSV REDIRECT/MERGE/REMOVE).
# Un salto, destino con trailing slash. No incluir estos paths en sitemap.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^inventarios-fisicos-argentina(\.html)?/?$ /servicios/inventarios-fisicos/ [R=301,L]
  RewriteRule ^inventarios-con-drones-depositos(\.html)?/?$ /servicios/inventarios-con-drones/ [R=301,L]
  RewriteRule ^empresa-inventarios-depositos-argentina(\.html)?/?$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^inventarios-depositos(\.html)?/?$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^inventarios-centros-distribucion-argentina(\.html)?/?$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^buenas-practicas/servicio-inventario-fisico-que-recibe-cliente(\.html)?/?$ /servicios/inventarios-fisicos/ [R=301,L]
  RewriteRule ^buenas-practicas/compromiso-cumplimiento-inventario-confiable(\.html)?/?$ /servicios/inventarios-fisicos/ [R=301,L]
</IfModule>
