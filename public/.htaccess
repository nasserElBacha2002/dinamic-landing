# Static MPA on Hostinger/LiteSpeed.
# Do not rewrite unknown paths to /index.html.

DirectoryIndex index.html
Options -MultiViews -Indexes
ErrorDocument 404 /404.html

# /a is a pre-existing Hostinger directory (no index.html). Site-wide -Indexes
# 403s https://dinamicsystems.com/a/ — verified in production. Allow listing
# only there via public/a/.htaccess. Do not prerender dist/a/index.html.

<IfModule mod_mime.c>
  AddType application/xml xml
</IfModule>

# Crawlers must be able to read sitemap and robots.
# Hostinger/LiteSpeed has returned 403 for some bot user-agents on sitemap.xml.
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule ^(sitemap\.xml|robots\.txt)$ - [L]
</IfModule>

# Internal 301s (Fase 1 + Fase 4). Exact match: path | path/ | path.html.
# No prefix capture. No SPA fallback. No Cloudflare/subdomains here.
# NOT executed until Hostinger upload (DEPLOY_NOT_EXECUTED).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Leave the pre-existing /a tree out of SEO 301s.
  RewriteRule ^a($|/) - [L]
  RewriteRule ^(inventarios-fisicos-argentina|inventarios-fisicos-argentina/|inventarios-fisicos-argentina\.html)$ /servicios/inventarios-fisicos/ [R=301,L]
  RewriteRule ^(inventarios-con-drones-depositos|inventarios-con-drones-depositos/|inventarios-con-drones-depositos\.html)$ /servicios/inventarios-con-drones/ [R=301,L]
  RewriteRule ^(empresa-inventarios-depositos-argentina|empresa-inventarios-depositos-argentina/|empresa-inventarios-depositos-argentina\.html)$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^(inventarios-depositos|inventarios-depositos/|inventarios-depositos\.html)$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^(inventarios-centros-distribucion-argentina|inventarios-centros-distribucion-argentina/|inventarios-centros-distribucion-argentina\.html)$ /industrias/depositos-centros-distribucion/ [R=301,L]
  RewriteRule ^(buenas-practicas/servicio-inventario-fisico-que-recibe-cliente|buenas-practicas/servicio-inventario-fisico-que-recibe-cliente/|buenas-practicas/servicio-inventario-fisico-que-recibe-cliente\.html)$ /servicios/inventarios-fisicos/ [R=301,L]
  RewriteRule ^(buenas-practicas/compromiso-cumplimiento-inventario-confiable|buenas-practicas/compromiso-cumplimiento-inventario-confiable/|buenas-practicas/compromiso-cumplimiento-inventario-confiable\.html)$ /servicios/inventarios-fisicos/ [R=301,L]
  RewriteRule ^(empresas-de-inventarios-en-argentina|empresas-de-inventarios-en-argentina/|empresas-de-inventarios-en-argentina\.html)$ /recursos/como-elegir-empresa-inventarios/ [R=301,L]
  RewriteRule ^(mejores-empresas-inventarios-argentina|mejores-empresas-inventarios-argentina/|mejores-empresas-inventarios-argentina\.html)$ /recursos/como-elegir-empresa-inventarios/ [R=301,L]
  RewriteRule ^(mejor-empresa-inventarios-fisicos-argentina|mejor-empresa-inventarios-fisicos-argentina/|mejor-empresa-inventarios-fisicos-argentina\.html)$ /recursos/como-elegir-empresa-inventarios/ [R=301,L]
  RewriteRule ^(como-elegir-empresa-inventarios-deposito|como-elegir-empresa-inventarios-deposito/|como-elegir-empresa-inventarios-deposito\.html)$ /recursos/como-elegir-empresa-inventarios/ [R=301,L]
  RewriteRule ^(inventario-fisico-tercerizado-argentina|inventario-fisico-tercerizado-argentina/|inventario-fisico-tercerizado-argentina\.html)$ /recursos/inventario-interno-vs-tercerizado/ [R=301,L]
  RewriteRule ^(inventario-manual-vs-tecnologico|inventario-manual-vs-tecnologico/|inventario-manual-vs-tecnologico\.html)$ /recursos/inventario-manual-vs-tecnologico/ [R=301,L]
  RewriteRule ^(cuanto-cuesta-inventario-deposito-argentina|cuanto-cuesta-inventario-deposito-argentina/|cuanto-cuesta-inventario-deposito-argentina\.html)$ /recursos/cuanto-cuesta-un-inventario-fisico/ [R=301,L]
  RewriteRule ^(inventarios-con-tecnologia-argentina|inventarios-con-tecnologia-argentina/|inventarios-con-tecnologia-argentina\.html)$ /innovacion/tecnologia-aplicada-inventarios/ [R=301,L]
  RewriteRule ^(tecnologia-inventarios|tecnologia-inventarios/|tecnologia-inventarios\.html)$ /innovacion/tecnologia-aplicada-inventarios/ [R=301,L]
  RewriteRule ^(inventarios-innovadores-argentina|inventarios-innovadores-argentina/|inventarios-innovadores-argentina\.html)$ /innovacion/ [R=301,L]
  RewriteRule ^(inventarios-inteligencia-artificial|inventarios-inteligencia-artificial/|inventarios-inteligencia-artificial\.html)$ /innovacion/inteligencia-artificial-inventarios/ [R=301,L]
  RewriteRule ^(innovacion/inventarios-fisicos-con-inteligencia-artificial|innovacion/inventarios-fisicos-con-inteligencia-artificial/|innovacion/inventarios-fisicos-con-inteligencia-artificial\.html)$ /innovacion/inteligencia-artificial-inventarios/ [R=301,L]
  RewriteRule ^(buenas-practicas/planificacion-inventario-fisico-cumplir-tiempos|buenas-practicas/planificacion-inventario-fisico-cumplir-tiempos/|buenas-practicas/planificacion-inventario-fisico-cumplir-tiempos\.html)$ /buenas-practicas/planificacion-inventario/ [R=301,L]
  RewriteRule ^(buenas-practicas/acompanamiento-cliente-inventario-fisico|buenas-practicas/acompanamiento-cliente-inventario-fisico/|buenas-practicas/acompanamiento-cliente-inventario-fisico\.html)$ /buenas-practicas/comunicacion-cliente-inventario/ [R=301,L]
  RewriteRule ^(buenas-practicas/preparacion-deposito-antes-inventario|buenas-practicas/preparacion-deposito-antes-inventario/|buenas-practicas/preparacion-deposito-antes-inventario\.html)$ /recursos/como-preparar-un-deposito-para-un-inventario/ [R=301,L]
  RewriteRule ^(buenas-practicas/metodologia-operativa-inventarios-fisicos|buenas-practicas/metodologia-operativa-inventarios-fisicos/|buenas-practicas/metodologia-operativa-inventarios-fisicos\.html)$ /investigacion/metodologia-inventarios/ [R=301,L]
  RewriteRule ^(buenas-practicas/control-pasillos-posiciones-inventario|buenas-practicas/control-pasillos-posiciones-inventario/|buenas-practicas/control-pasillos-posiciones-inventario\.html)$ /buenas-practicas/control-posiciones-pasillos/ [R=301,L]
  RewriteRule ^(buenas-practicas/evitar-productos-duplicados-cantidades-incorrectas|buenas-practicas/evitar-productos-duplicados-cantidades-incorrectas/|buenas-practicas/evitar-productos-duplicados-cantidades-incorrectas\.html)$ /buenas-practicas/evitar-duplicados-cantidades/ [R=301,L]
  RewriteRule ^(buenas-practicas/reconteos-inteligentes-diferencias-inventario|buenas-practicas/reconteos-inteligentes-diferencias-inventario/|buenas-practicas/reconteos-inteligentes-diferencias-inventario\.html)$ /buenas-practicas/reconteos-inteligentes/ [R=301,L]
  RewriteRule ^(buenas-practicas/comunicacion-cliente-durante-inventario|buenas-practicas/comunicacion-cliente-durante-inventario/|buenas-practicas/comunicacion-cliente-durante-inventario\.html)$ /buenas-practicas/comunicacion-cliente-inventario/ [R=301,L]
  RewriteRule ^(buenas-practicas/resultados-auditables-inventario-fisico|buenas-practicas/resultados-auditables-inventario-fisico/|buenas-practicas/resultados-auditables-inventario-fisico\.html)$ /buenas-practicas/resultados-auditables/ [R=301,L]
  RewriteRule ^(buenas-practicas/inventario-offline-problemas-conectividad|buenas-practicas/inventario-offline-problemas-conectividad/|buenas-practicas/inventario-offline-problemas-conectividad\.html)$ /innovacion/tecnologia-movil-offline/ [R=301,L]
  RewriteRule ^(buenas-practicas/operacion-organizada-experiencia-cliente-inventario|buenas-practicas/operacion-organizada-experiencia-cliente-inventario/|buenas-practicas/operacion-organizada-experiencia-cliente-inventario\.html)$ /buenas-practicas/comunicacion-cliente-inventario/ [R=301,L]
  RewriteRule ^(innovacion/tecnologia-movil-operacion-offline-inventarios|innovacion/tecnologia-movil-operacion-offline-inventarios/|innovacion/tecnologia-movil-operacion-offline-inventarios\.html)$ /innovacion/tecnologia-movil-offline/ [R=301,L]
  RewriteRule ^(innovacion/etiquetas-inteligentes-trazabilidad-posicion|innovacion/etiquetas-inteligentes-trazabilidad-posicion/|innovacion/etiquetas-inteligentes-trazabilidad-posicion\.html)$ /innovacion/etiquetas-inteligentes/ [R=301,L]
  RewriteRule ^(innovacion/drones-vision-artificial-inventarios|innovacion/drones-vision-artificial-inventarios/|innovacion/drones-vision-artificial-inventarios\.html)$ /innovacion/drones-inventarios/ [R=301,L]
</IfModule>
